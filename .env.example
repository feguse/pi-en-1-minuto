# Clave de OpenRouter (https://openrouter.ai/keys)
# Si esta variable no existe, la app funciona en MODO DEMO con un resultado simulado.
OPENROUTER_API_KEY=

# Opcional: modelo de OpenRouter a utilizar.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Opcional: se envian como encabezados de atribucion a OpenRouter.
OPENROUTER_SITE_URL=https://pi-en-1-minuto.vercel.app
OPENROUTER_SITE_NAME=PI en 1 minuto
